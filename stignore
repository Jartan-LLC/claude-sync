// Written by `claude-sync setup`, which replaces any local edits on each run.
// Everything in ~/.claude syncs except what is meaningless or harmful on another machine.

// Login token: one per device.
/.credentials.json

// Named after a process ID on one machine.
/sessions/*.json
/sessions/*.key

// Held by a process on one machine. (?d) lets a peer's delete of a task's folder remove
// the leftover lock too; .in_use has no (?d), so a plugin a session is using stays put.
/.update.lock
/ide/*.lock
(?d)/tasks/*/.lock
/plugins/cache/**/.in_use

// Git clones each machine pulls on its own; syncing one .git between two pullers corrupts it.
/plugins/marketplaces

// This machine's daemon, session environments, shell snapshots and unsent telemetry.
/daemon
/session-env
/shell-snapshots
/telemetry

// Half-written files mid-save, such as settings.json.tmp.<pid>.<time>.
*.tmp.[0-9]*
