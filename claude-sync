#!/usr/bin/env bash
# Keep ~/.claude in sync across devices with Syncthing. See README.md.
set -euo pipefail

# BEGIN ASSETS: packaging/build.sh replaces this block with the version and the files.
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
readonly here claude_sync_version=dev
# Prints one of claude-sync's own files: compose.yaml, compose.path.yaml,
# compose.volume.yaml or stignore.
asset() {
    cat -- "$here/$1"
}
# END ASSETS
readonly default_name=claude-sync

# Where `claude-sync use` keeps the selected instance. Fails when there is no home to
# keep it in. A relative XDG_CONFIG_HOME is ignored, as the XDG spec says: the selection
# would follow the working directory.
selection_file() {
    local dir=${HOME:+$HOME/.config}
    [[ ${XDG_CONFIG_HOME:-} != /* ]] || dir=$XDG_CONFIG_HOME
    [[ -n $dir ]] || return 1
    echo "$dir/claude-sync/instance"
}

# The instance `claude-sync use` selected. Fails when none is. For a file that is empty or
# cannot be read it prints nothing, which check_name refuses: falling back to the default
# would let uninstall remove claude-sync unannounced.
selected_instance() {
    local file
    file=$(selection_file) && [[ -e $file ]] || return 1
    head -n 1 -- "$file" 2>/dev/null || true
}

# What chose the instance: CLAUDE_SYNC_NAME, which wins so neither scripts nor upgrade's
# setup of each instance follow a selection, then the selection, else the default.
if [[ -n ${CLAUDE_SYNC_NAME:-} ]]; then
    name_from=variable
elif CLAUDE_SYNC_NAME=$(selected_instance); then
    name_from=selection
else
    CLAUDE_SYNC_NAME=$default_name name_from=default
fi
readonly name_from
# Exported for compose.yaml.
export CLAUDE_SYNC_NAME
readonly name=$CLAUDE_SYNC_NAME
readonly folder_id=claude-sync
# Devices unpaired anywhere, one empty file per device ID in the synced folder, so every
# device sees them and unpairs of different devices never touch the same file.
readonly unpaired_dir=.claude-sync-unpaired
# Syncthing also accepts other spellings of an ID, but its CLI and the checks here match
# only this one, as setup prints it.
readonly id_re='^[A-Z2-7]{7}(-[A-Z2-7]{7}){7}$'
# The synced folder as Syncthing sees it; with --use-host-syncthing, the directory itself.
folder_path=/var/syncthing/claude
readonly trash_days=14
readonly default_gui_port=8384 default_sync_port=22000
readonly label=claude-sync=config
# The version of claude-sync that last set an instance up, in its config volume beside the
# companion, or beside the config file of the Syncthing on this host.
readonly stamp=claude-sync-version
# GitHub's list of releases; the tests point it at a file.
readonly releases_api=${CLAUDE_SYNC_RELEASES_API:-https://api.github.com/repos/Jartan-LLC/claude-sync/releases?per_page=100}
owner=""
compose_files=()
probe_error=""
# Set by check_releases.
releases="" release_safe="" release_breaking=""
# Set by use_host for the Syncthing on this host.
mode=container where="in container $name" api_url="" api_key="" api_tls=()

usage() {
    cat <<'EOF'
Usage:
  claude-sync setup --volume NAME   Sync the Docker volume NAME that holds ~/.claude
  claude-sync setup --path DIR      Sync the directory DIR on this host
      --use-host-syncthing          With --path only: use the Syncthing already running
                                    as this user on this host instead of a container.
                                    Needs Syncthing 2 or newer and curl, not Docker
      --private                     No global discovery, relays or NAT traversal: other
                                    devices are found on the LAN or at the address given
                                    to pair. Can't be combined with --use-host-syncthing
      --public                      Back to Syncthing's defaults. Can't be combined
                                    with --use-host-syncthing
      --gui-port PORT               Web UI port. Without it, a new device takes 8384,
                                    or a free port when 8384 is taken, and keeps it.
                                    Can't be combined with --use-host-syncthing
      --sync-port PORT              Sync port. Without it, a new device takes 22000, or
                                    a free port when 22000 is taken, and keeps it.
                                    Can't be combined with --use-host-syncthing
      --backup-dir DIR              Run claude-sync backup DIR daily, with a systemd user
                                    timer, while you are logged in. Later runs of setup
                                    keep it
      --no-backup                   Remove that daily backup
  claude-sync setup                 Apply this version to the instance already set up,
                                    keeping its target, and its ports, --private and
                                    daily backup unless given again
  claude-sync upgrade               Install the newest release that is not breaking, then
                                    apply it to every running instance on this host.
                                    Not for an RPM install: upgrade that with dnf, then
                                    run setup
  claude-sync pair DEVICE-ID        Sync with the device DEVICE-ID; run on both devices.
                                    A device that syncs with no other yet joins: it waits
                                    for the files of DEVICE-ID and the devices it syncs
                                    with, then moves its own changes to the trash can
      --keep                        Keep this device's files instead of joining, as the
                                    first device of a new set does. Paired with devices
                                    that already have files, its files merge with theirs:
                                    the newer copy wins and the other is kept as a
                                    conflict copy
      --address tcp://HOST:22000    Where to reach DEVICE-ID; required on a private
                                    device. Pairing again with it replaces the address
  claude-sync unpair DEVICE-ID      Remove the device DEVICE-ID from every device; run it
                                    on any device. A device using its own Syncthing drops
                                    it the next time claude-sync runs there
  claude-sync uninstall             Remove claude-sync's container and Syncthing state,
                                    or its folder from the Syncthing on this host, and
                                    its daily backup; the synced files and the backups
                                    are left untouched
  claude-sync backup DIR            Write an archive of the whole synced folder, ignored
                                    files and trash can included, to DIR, then remove
                                    this instance's older archives there
      --keep-weekly N               Keep the newest archive of each of the last N weeks
                                    that have one; default 4
      --keep-monthly N              Keep the newest archive of each of the last N months
                                    that have one; default 6
  claude-sync restore ARCHIVE --volume NAME | --path DIR
                                    Extract a backup, made on any device, over the Docker
                                    volume NAME or the directory DIR on this machine.
                                    Removes nothing; in a synced folder, the restored files
                                    sync to every device
  claude-sync list                  List this host's instances
  claude-sync use NAME              Make later commands act on instance NAME
                                    (default: claude-sync)
  claude-sync version
  claude-sync help

Environment:
  CLAUDE_SYNC_NAME                  The instance to act on; overrides the one selected
                                    with use
EOF
}

die() {
    printf 'claude-sync: %s\n' "$*" >&2
    exit 1
}

# Compose's project-name rule, plus Docker's two-character minimum for container names,
# since an instance's name is both.
valid_name() {
    [[ $1 =~ ^[a-z0-9][a-z0-9_-]+$ ]]
}

check_name() {
    valid_name "$name" && return 0
    if [[ $name_from == selection ]]; then
        die "$(selection_file) does not hold a valid instance name; select one again with claude-sync use NAME"
    fi
    die "CLAUDE_SYNC_NAME must be two or more lowercase letters, digits, '-' or '_', starting with a letter or digit: $name"
}

# For a command that acts on the instance: refuses an invalid name, then says which
# instance it acts on, and what chose it, when it is not the default.
check_instance() {
    check_name
    [[ $name != "$default_name" ]] || return 0
    local by="named by CLAUDE_SYNC_NAME"
    [[ $name_from != selection ]] || by="selected with claude-sync use"
    printf 'claude-sync: acting on instance %s, %s\n' "$name" "$by" >&2
}

syncthing_run() {
    if [[ $mode == host ]]; then
        syncthing "$@"
    else
        docker exec -u "$owner" "$name" syncthing "$@"
    fi
}

st() {
    syncthing_run cli "$@"
}

compose() {
    docker compose -p "$name" "${compose_files[@]}" "$@"
}

# The running instance's REST API at PATH, then extra curl options, for what
# `syncthing cli` does not cover.
rest() {
    if [[ $mode == host ]]; then
        local path=$1
        shift
        # The key goes on stdin, since other users can read a process's arguments.
        curl -fsS "${api_tls[@]}" "$@" -K - "$api_url$path" <<<"header = \"X-API-Key: $api_key\""
        return
    fi
    # shellcheck disable=SC2016 # expanded by the container's shell
    docker exec -u "$owner" "$name" sh -c \
        'path=$1; shift
        curl -fsS "$@" -H "X-API-Key: $(syncthing cli config gui apikey get)" \
            "http://$(syncthing cli config gui raw-address get)$path"' \
        sh "$@"
}

# A top-level KEY of the REST API's JSON. The API prints one key per line, so sed reads it
# and users need no jq.
field() {
    sed -n "s/^  \"$1\": \(.*\)\$/\1/p" | sed 's/,$//; s/^"\(.*\)"$/\1/'
}

folder_status() {
    rest "/rest/db/status?folder=$folder_id"
}

# Matches a version such as 0.4.1, v0.4.1, 0.4.1-rc.1 or, as an RPM gives it, 0.4.1~rc.1,
# into BASH_REMATCH: major, minor and patch at 1 to 3, the pre-release part at 4.
parse_version() {
    [[ $1 =~ ^v?([0-9]+)\.([0-9]+)\.([0-9]+)([-~].+)?$ ]]
}

# Whether version A comes before version B, as SemVer orders them, except that two
# pre-releases of one version are not ordered: only a release follows its pre-releases.
version_older() {
    local a b i
    parse_version "$1" || return 1
    a=("${BASH_REMATCH[@]:1}")
    parse_version "$2" || return 1
    b=("${BASH_REMATCH[@]:1}")
    for i in 0 1 2; do
        if ((10#${a[i]} != 10#${b[i]})); then
            ((10#${a[i]} < 10#${b[i]}))
            return
        fi
    done
    [[ -n ${a[3]} && -z ${b[3]} ]]
}

# Whether going from version A to the later version B is breaking by the project's rule
# (CONTRIBUTING.md, Releasing): a new major version, or a new minor version while the
# major is 0.
version_breaking() {
    local a b
    parse_version "$1" || return 1
    a=("${BASH_REMATCH[@]:1}")
    parse_version "$2" || return 1
    b=("${BASH_REMATCH[@]:1}")
    ((10#${a[0]} != 10#${b[0]} || (10#${a[0]} == 0 && 10#${a[1]} != 10#${b[1]})))
}

# Fetches the list of releases into releases, which release_url reads, then sets
# release_safe to the newest release after this version that is not breaking, and
# release_breaking to the newest that is, each a tag or empty. Pre-releases are left out.
check_releases() {
    local tag
    release_safe="" release_breaking=""
    releases=$(curl -fsSL -- "$releases_api") || die "cannot get the list of claude-sync's releases from $releases_api"
    # grep, as the list may come on one line or many, and users need no jq.
    while IFS= read -r tag; do
        [[ $tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
        version_older "$claude_sync_version" "$tag" || continue
        if ! version_breaking "$claude_sync_version" "$tag"; then
            if [[ -z $release_safe ]] || version_older "$release_safe" "$tag"; then release_safe=$tag; fi
        elif [[ -z $release_breaking ]] || version_older "$release_breaking" "$tag"; then
            release_breaking=$tag
        fi
    done < <(grep -o '"tag_name": *"[^"]*"' <<<"$releases" | sed 's/.*"\([^"]*\)"$/\1/')
}

# The URL, from the list in releases, of the release TAG's notes, or with FILE, of that
# file of the release.
release_url() {
    local tag=${1//./\\.} pattern
    if (($# == 2)); then
        pattern="\"browser_download_url\": *\"[^\"]*/$tag/${2//./\\.}\""
    else
        pattern="\"html_url\": *\"[^\"]*/releases/tag/$tag\""
    fi
    grep -m 1 -o "$pattern" <<<"$releases" | sed 's/.*"\([^"]*\)"$/\1/'
}

# Whether COMMAND prints the line LINE. Not grep -q: it stops reading at the first match,
# and the command, killed by SIGPIPE writing its next line, fails the pipeline under pipefail.
prints_line() {
    local line=$1
    shift
    "$@" | grep -xF -- "$line" >/dev/null
}

# Dies with Syncthing's own message when it cannot run the folder, such as an ignore
# pattern it rejects. Syncthing loads the ignore list after starting and before it scans or
# pulls, so any later state means the folder runs; a scan or sync under way is not waited
# for. Dies too when Syncthing's API never answers.
wait_folder_started() {
    local i status state reached=""
    for ((i = 0; i < 120; i++)); do
        if status=$(folder_status); then
            reached=1
        else
            status=""
            ((i < 15)) || [[ -n $reached ]] || die "cannot reach Syncthing $where"
        fi
        state=$(field state <<<"$status")
        case $state in
            error) die "Syncthing cannot sync the folder: $(field error <<<"$status")" ;;
            starting) ;;
            ?*) return 0 ;;
        esac
        sleep 1
    done
}

# Has Syncthing load the ignore list as its web UI does: saved, applied at once and scanned
# in the background. A written .stignore alone waits for the folder's next scan or pull.
load_ignores() {
    local lines answer err
    # One JSON string per line; the list holds no control characters.
    lines=$(asset stignore | sed 's/[\\"]/\\&/g; s/.*/"&"/' | paste -sd, -)
    answer=$(rest "/rest/db/ignores?folder=$folder_id" -X POST -H 'Content-Type: application/json' \
        -d "{\"ignore\": [$lines]}") || die "cannot reach Syncthing $where"
    err=$(field error <<<"$answer")
    [[ $err == null ]] || die "Syncthing cannot use the ignore list: $err"
}

# Tells that Syncthing is still at work on the folder. Only a hint, so it says nothing
# when Syncthing does not answer.
tell_busy() {
    local status
    status=$(folder_status) || return 0
    [[ $(field state <<<"$status") == idle ]] ||
        echo "Syncthing is still scanning or syncing your files; see progress at $(web_ui)."
}

# Syncthing's web UI, for messages.
web_ui() {
    if [[ $mode == host ]]; then
        echo "$api_url"
    else
        echo "http://$(st config gui raw-address get)"
    fi
}

add_folder() {
    st config folders add --id "$folder_id" --label claude --path "$folder_path" --type "$1"
    set_trash_can
}

# Applies the ignore list just written to an existing folder, or adds the folder.
ensure_folder() {
    if prints_line "$folder_id" st config folders list; then
        load_ignores
    else
        add_folder sendreceive
    fi
}

set_trash_can() {
    st config folders "$folder_id" versioning type set trashcan
    st config folders "$folder_id" versioning params set cleanoutDays "$trash_days"
}

running() {
    [[ $(docker container inspect --format '{{.State.Running}}' "$name" 2>/dev/null) == true ]]
}

gui_port() {
    local address
    address=$(st config gui raw-address get) || return
    echo "${address##*:}"
}

# The port of the first TCP listen address; Syncthing's "default" means 22000.
sync_port() {
    local options line re='"tcp[46]?://[^"]*:([0-9]+)"'
    options=$(st config options dump-json) || return
    while IFS= read -r line; do
        if [[ $line =~ $re ]]; then
            echo "${BASH_REMATCH[1]}"
            return
        fi
    done <<<"$options"
    echo "$default_sync_port"
}

# Whether PORT is free on the service's network, which is the host's even when
# claude-sync itself runs in a container: 0 free, 1 in use, 2 unknown (see probe_error).
port_free() {
    local probe
    # nc's own status is echoed so a failing `compose run` cannot pass for a free port.
    # shellcheck disable=SC2016 # expanded by the container's shell
    probe=$(compose run --rm --no-deps --entrypoint sh syncthing \
        -c 'nc -z 127.0.0.1 "$1"; echo "nc=$?"' sh "$1" 2>&1 </dev/null) || true
    case ${probe##*$'\n'} in
        nc=1) return 0 ;;
        nc=0) return 1 ;;
        *)
            probe_error=$probe
            return 2
            ;;
    esac
}

ours_volume() {
    [[ $(docker volume inspect --format "{{index .Labels \"${label%=*}\"}}" "$1") == "${label#*=}" ]]
}

ours_container() {
    [[ $(docker container inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' "$1") == "$1" ]]
}

# The volume name or host path the existing container NAME syncs, if any.
current_target() {
    docker container inspect --format "{{range .Mounts}}{{if eq .Destination \"$folder_path\"}}{{if eq .Type \"volume\"}}{{.Name}}{{else}}{{.Source}}{{end}}{{end}}{{end}}" \
        "$1" 2>/dev/null
}

host_config_file() {
    command -v syncthing >/dev/null || return 1
    syncthing paths 2>/dev/null | sed -n '/^Configuration file:/{n;s/^[[:space:]]*//p;}'
}

# Whether this user has a Syncthing on this host, running or not: its config file exists.
host_syncthing_configured() {
    local config
    config=$(host_config_file) || return 1
    [[ -f $config ]]
}

# This user's Syncthing's folders, as ID, a tab and path per line, read from its config
# file so they are found whether that Syncthing runs or not.
host_folders() {
    local config tab=$'\t'
    config=$(host_config_file) || return 0
    # A folder with no ID is the defaults block's template for new folders. The tab is put
    # in by bash, as not every sed reads \t.
    sed -n "s/^ *<folder id=\"\\([^\"][^\"]*\\)\" [^>]*path=\"\\([^\"]*\\)\".*/\\1$tab\\2/p" "$config" |
        sed -e 's/&lt;/</g' -e 's/&gt;/>/g' -e 's/&quot;/"/g' -e 's/&#34;/"/g' \
            -e "s/&apos;/'/g" -e "s/&#39;/'/g" -e 's/&amp;/\&/g'
}

# This host's claude-sync instances, one per line as the instance's name, a tab and its
# status: container (running), stopped (its container is not running), state-only (its
# Syncthing state is left but no container of claude-sync's uses it) or host
# (claude-sync's folder in the Syncthing of this user on this host, which is always the
# default name's). Fails, after listing the rest, when docker cannot list the volumes.
instances() {
    local volumes volume instance unlisted=0
    if command -v docker >/dev/null; then
        if volumes=$(docker volume ls -q --filter "label=$label"); then
            while IFS= read -r volume; do
                instance=${volume%-config}
                [[ $instance != "$volume" ]] || continue
                if ! docker container inspect "$instance" >/dev/null 2>&1 || ! ours_container "$instance"; then
                    printf '%s\tstate-only\n' "$instance"
                elif [[ $(docker container inspect --format '{{.State.Running}}' "$instance") == true ]]; then
                    printf '%s\tcontainer\n' "$instance"
                else
                    printf '%s\tstopped\n' "$instance"
                fi
            done < <(sort <<<"$volumes")
        else
            unlisted=1
        fi
        # setup refuses a host instance beside a container of the default name.
        if docker container inspect "$default_name" >/dev/null 2>&1; then
            return "$unlisted"
        fi
    fi
    if prints_line "$folder_id" cut -f 1 < <(host_folders); then
        printf '%s\thost\n' "$default_name"
    fi
    return "$unlisted"
}

# The file in which an instance whose Syncthing runs in PLACE, container or host, records
# its version; for a container, a path inside it.
stamp_file() {
    local config
    case $1 in
        container) echo "/var/syncthing/config/$stamp" ;;
        host) config=$(host_config_file) && echo "${config%/*}/$stamp" ;;
        *) return 1 ;;
    esac
}

# The version of claude-sync that last set up the instance NAME, whose Syncthing runs in
# PLACE, container or host. Fails when there is none: it predates the stamp, or its
# container is not running.
instance_version() {
    local file
    file=$(stamp_file "$2") || return 1
    case $2 in
        container) docker exec "$1" cat "$file" 2>/dev/null ;;
        host) cat -- "$file" 2>/dev/null ;;
    esac
}

# Records this version in the instance NAME, whose Syncthing runs in PLACE, once it is set
# up.
write_stamp() {
    local file
    file=$(stamp_file "$2") || die "cannot record the version in instance $1"
    case $2 in
        container) docker exec -i -u "$owner" "$1" sh -c "cat >$file" <<<"$claude_sync_version" ;;
        host) printf '%s\n' "$claude_sync_version" >"$file" ;;
    esac || die "cannot record the version in instance $1"
}

# Whether an instance that claude-sync version STAMP set up needs this version's setup.
# An empty STAMP, from before the stamp, or one that is not a version, as `dev` from a
# checkout, says nothing, so that instance does. A claude-sync that is not a version
# itself, as `dev`, counts no instance as needing it.
stale() {
    parse_version "$claude_sync_version" || return 1
    [[ -z $1 ]] || ! parse_version "$1" || version_older "$1" "$claude_sync_version"
}

# The command that sets up the instance NAME again, for messages. With a selection, the
# bare command would act on the selected instance.
setup_command() {
    local prefix="CLAUDE_SYNC_NAME=$1 "
    if [[ $1 == "$default_name" ]] && ! selected_instance >/dev/null; then
        prefix=""
    fi
    echo "${prefix}claude-sync setup"
}

# Tells when an older claude-sync set this instance up.
warn_stale() {
    local place=container version by="an older claude-sync"
    [[ $mode != host ]] || place=host
    version=$(instance_version "$name" "$place") || version=""
    stale "$version" || return 0
    [[ -z $version ]] || by="claude-sync $version"
    printf 'claude-sync: this instance was last set up by %s; run %s to apply %s\n' \
        "$by" "$(setup_command "$name")" "$claude_sync_version" >&2
}

# PATH with a leading ~ expanded where it stands for the home directory, alone or before a
# slash. ~NAME, which a shell reads as NAME's home, is left as it is.
expand_home() {
    if [[ $1 == \~ || $1 == \~/* ]]; then
        printf '%s\n' "$HOME${1#\~}"
    else
        printf '%s\n' "$1"
    fi
}

# PATH with its ~ expanded as expand_home does and, where it exists here, symlinks resolved:
# Syncthing follows a symlinked folder root.
real_path() {
    local path
    path=$(expand_home "$1")
    (cd -- "$path" 2>/dev/null && pwd -P) || echo "${path%/}"
}

# The nearest of PATH and its ancestors that is a directory here, or . for a relative PATH
# with none.
nearest_dir() {
    local path=$1
    while [[ ! -d $path ]]; do
        if [[ $path == */* ]]; then
            path=${path%/*}
            path=${path:-/}
        else
            path=.
        fi
    done
    printf '%s\n' "$path"
}

# PATH as real_path gives it, for a directory that may not exist yet: its nearest existing
# ancestor resolved, and the rest, which mkdir -p would make, cleaned.
planned_path() {
    local path base
    path=$(expand_home "$1")
    # So that cutting nearest_dir's . off the front never takes the dot of a hidden name such
    # as .cache.
    [[ $path == /* ]] || path=./$path
    base=$(nearest_dir "$path")
    clean_path "$(real_path "$base")/${path#"$base"}"
}

# Whether resolved PATH is DIR or inside it. The slash is dropped before adding one, so a DIR
# at / holds every path.
path_within() {
    [[ $1 == "$2" || $1 == "${2%/}"/* ]]
}

# Whether one of two resolved paths is the other or inside it, so both would sync the same
# files.
paths_overlap() {
    path_within "$1" "$2" || path_within "$2" "$1"
}

# PATH made absolute and cleaned as Docker cleans a bind mount's path: no ".", ".." or
# repeated or trailing slashes. Without needing it to exist here, since Docker resolves the
# path on its host, and in bash alone, since realpath's options differ between systems.
clean_path() {
    local path=$1 part parts cleaned=()
    [[ $path == /* ]] || path=$PWD/$path
    IFS=/ read -ra parts <<<"$path"
    for part in "${parts[@]}"; do
        case $part in
            '' | .) ;;
            ..) ((${#cleaned[@]} == 0)) || unset 'cleaned[${#cleaned[@]}-1]' ;;
            *) cleaned+=("$part") ;;
        esac
    done
    local IFS=/
    echo "/${cleaned[*]}"
}

# Another container from a Syncthing image, running or stopped, that mounts TARGET, a
# volume name or a host path, if any.
target_taken_by() {
    local cname cimage mounts
    while IFS='|' read -r cname cimage mounts; do
        cname=${cname#/}
        [[ $cname != "$name" && $cimage == *syncthing* ]] || continue
        if [[ ";$mounts" == *";$1;"* ]]; then
            echo "$cname"
            return
        fi
    done < <(docker ps -aq | xargs -r docker container inspect --format \
        '{{.Name}}|{{.Config.Image}}|{{range .Mounts}}{{if eq .Type "volume"}}{{.Name}}{{else}}{{.Source}}{{end}};{{end}}' 2>/dev/null)
}

# Points the helpers at the Syncthing running as this user on this host.
use_host() {
    mode=host where="on this host"
    command -v syncthing >/dev/null || die "Syncthing is not installed on this host"
    command -v curl >/dev/null || die "curl is required"
    local address
    { address=$(st config gui raw-address get) && api_key=$(st config gui apikey get); } 2>/dev/null ||
        die "cannot reach the Syncthing on this host; is it running as $(id -un)?"
    # An address with no host listens on all of them.
    [[ $address != :* ]] || address=127.0.0.1$address
    api_url=http://$address
    if [[ $(st config gui raw-use-tls get) == true ]]; then
        # Its certificate is self-signed.
        api_url=https://$address api_tls=(-k)
    fi
}

# Container mode when claude-sync's container exists, else the Syncthing this user has
# configured on this host.
detect_mode() {
    if command -v docker >/dev/null && docker container inspect "$name" >/dev/null 2>&1; then
        { running && ours_container "$name"; } || die "Syncthing is not running in container $name; run setup first"
        local env
        env=$(docker container inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$name")
        owner=$(sed -n 's/^PUID=//p' <<<"$env"):$(sed -n 's/^PGID=//p' <<<"$env")
        warn_stale
    elif [[ $name == "$default_name" ]] && host_syncthing_configured; then
        use_host
        folder_path=$(st config folders "$folder_id" path get 2>/dev/null) ||
            die "claude-sync is not set up on this device; run setup first"
        warn_stale
        # No companion runs beside this Syncthing, so every command that acts on it applies
        # the list.
        apply_unpaired
    else
        die "claude-sync is not set up on this device; run setup first"
    fi
}

# Removes the devices on the unpaired list from this device's Syncthing. In a container,
# the start command (compose.yaml) runs it in a loop beside Syncthing, since introductions
# would bring an unpaired device back. Kept POSIX: it runs in the image's shell. Its
# arguments are DIR, the list's directory, and FOLDER, claude-sync's folder ID.
companion_script() {
    cat <<'EOF'
apply() {
    [ -d "$1" ] || return 0
    self=$(syncthing device-id 2>/dev/null)
    { [ -n "$self" ] && devices=$(syncthing cli config devices list 2>/dev/null); } || return 0
    for d in $devices; do
        # Syncthing would re-create this device's own entry, losing its name.
        [ "$d" != "$self" ] && [ -e "$1/$d" ] || continue
        # Either may have gone already, removed by another pass of this script.
        syncthing cli config folders "$2" devices "$d" delete 2>/dev/null || :
        # A device that also syncs other folders of this Syncthing stays for those.
        shared=""
        for f in $(syncthing cli config folders list); do
            if [ "$f" != "$2" ] && syncthing cli config folders "$f" devices list | grep -qxF "$d"; then
                shared=1
            fi
        done
        [ -n "$shared" ] || syncthing cli config devices "$d" delete 2>/dev/null || :
    done
    return 0
}
apply "$1" "$2"
EOF
}

apply_unpaired() {
    if [[ $mode == host ]]; then
        companion_script | sh -s "$folder_path/$unpaired_dir" "$folder_id"
    else
        companion_script | docker exec -i -u "$owner" "$name" sh -s "$folder_path/$unpaired_dir" "$folder_id"
    fi
}

# Runs the sh SCRIPT with ARGS where the synced folder is: in the container, or here.
in_folder() {
    if [[ $mode == host ]]; then
        sh -c "$@"
    else
        docker exec -u "$owner" "$name" sh -c "$@"
    fi
}

# Takes ID off the unpaired list, so the device can be paired again. The deletion is
# indexed, and so offered to the other devices, before pair introduces the device, or
# their companions would remove it again on its way in.
forget_unpaired() {
    # shellcheck disable=SC2016 # expanded by sh
    in_folder '[ -e "$1" ] && rm "$1"' sh "$folder_path/$unpaired_dir/$1" || return 0
    rest "/rest/db/scan?folder=$folder_id" -X POST >/dev/null || die "cannot reach Syncthing $where"
    wait_folder_started
}

# Sets kind and target to this instance's, and host for one in the Syncthing on this host,
# for setup with no target. Fails when there is no instance.
current_setup() {
    if command -v docker >/dev/null && docker container inspect "$name" >/dev/null 2>&1; then
        ours_container "$name" || die "container $name was not created by claude-sync"
        target=$(current_target "$name")
        [[ -n $target ]] || die "container $name syncs nothing; run uninstall, then setup with --volume or --path"
        kind=volume
        [[ $(docker container inspect --format "{{range .Mounts}}{{if eq .Destination \"$folder_path\"}}{{.Type}}{{end}}{{end}}" \
            "$name") != bind ]] || kind=path
        return 0
    fi
    [[ $name == "$default_name" ]] || return 1
    local tab=$'\t'
    target=$(host_folders | sed -n "s/^$folder_id$tab//p")
    [[ -n $target ]] || return 1
    kind=path host=1
}

setup() {
    # backup: empty to keep the daily backup as it is, off, or the absolute DIR to back up to.
    local kind="" target="" network="" host="" want_gui="" want_sync="" backup=""
    while (($#)); do
        case $1 in
            --volume | --path)
                [[ -z $kind ]] || die "give only one of --volume or --path"
                (($# >= 2)) || die "$1 needs a value"
                kind=${1#--} target=$2
                shift 2
                ;;
            --private | --public)
                [[ -z $network || $network == "${1#--}" ]] || die "give only one of --private or --public"
                network=${1#--}
                shift
                ;;
            --use-host-syncthing)
                host=1
                shift
                ;;
            --gui-port | --sync-port)
                (($# >= 2)) || die "$1 needs a value"
                if ! [[ $2 =~ ^[1-9][0-9]{3,4}$ ]] || (($2 < 1024 || $2 > 65535)); then
                    die "not a port: $2; give one from 1024 to 65535"
                fi
                if [[ $1 == --gui-port ]]; then want_gui=$2; else want_sync=$2; fi
                shift 2
                ;;
            --backup-dir)
                [[ $backup != off ]] || die "give only one of --backup-dir or --no-backup"
                [[ -n ${2:-} ]] || die "$1 needs a value"
                [[ $2 != *$'\n'* ]] || die "paths containing a newline are not supported"
                backup=$(clean_path "$(expand_home "$2")")
                shift 2
                ;;
            --no-backup)
                [[ $backup != /* ]] || die "give only one of --backup-dir or --no-backup"
                backup=off
                shift
                ;;
            *) die "unknown argument: $1" ;;
        esac
    done
    check_instance
    if [[ $backup == /* ]] && ! user_systemd; then
        die "--backup-dir needs systemd's user manager (systemctl --user), which is not running for $(id -un) here; schedule claude-sync backup DIR another way, such as with cron"
    fi
    [[ $backup != off ]] || check_unschedule
    if [[ -z $kind ]] && ! current_setup; then
        # A daemon that is not running would otherwise pass for no instance in a container.
        if command -v docker >/dev/null && ! docker info >/dev/null 2>&1; then
            die "docker cannot be reached, so setup cannot tell whether instance $name runs in a container; once docker works, rerun $(setup_command "$name")"
        fi
        # An instance removed outside claude-sync leaves its timer firing at nothing.
        if [[ $backup == off ]] && has_scheduled_backup; then
            unschedule_backup
            return
        fi
        usage >&2
        exit 2
    fi
    [[ -z $want_gui || $want_gui != "$want_sync" ]] || die "--gui-port and --sync-port need different ports"
    if [[ -n $host ]]; then
        [[ $kind == path ]] || die "--use-host-syncthing works only with --path: a Syncthing on the host cannot reach a Docker volume"
        [[ -z $network ]] || die "--$network changes how all of a Syncthing's folders connect; with --use-host-syncthing, set them in that Syncthing"
        [[ -z $want_gui$want_sync ]] || die "--gui-port and --sync-port change that Syncthing's own ports; with --use-host-syncthing, set them in that Syncthing"
        # One Syncthing holds one claude-sync folder, so names would not keep instances apart.
        if [[ $name != "$default_name" ]]; then
            [[ $name_from != selection ]] ||
                die "--use-host-syncthing sets up only the default instance, $default_name; run claude-sync use $default_name first"
            local selected fix="leave CLAUDE_SYNC_NAME unset"
            if selected=$(selected_instance) && [[ $selected != "$default_name" ]]; then
                fix+=" and run claude-sync use $default_name first"
            fi
            die "CLAUDE_SYNC_NAME names claude-sync's own containers; with --use-host-syncthing, $fix"
        fi
        setup_host "$target" "$backup"
        return
    fi
    command -v docker >/dev/null || die "Docker is required"
    if [[ $kind == path ]]; then
        [[ $target != *$'\n'* ]] || die "paths containing a newline are not supported"
        target=$(clean_path "$target")
    fi
    # Under the default name, pair, unpair, backup and uninstall would act on a container
    # instead of the Syncthing that already syncs claude-sync's folder. With --path, under any
    # name, the container would also be a second device on files a folder of that Syncthing
    # syncs.
    if host_syncthing_configured; then
        local fid fpath real_target=""
        [[ $kind != path ]] || real_target=$(real_path "$target")
        while IFS=$'\t' read -r fid fpath; do
            if [[ $fid == "$folder_id" && $name == "$default_name" ]]; then
                [[ $kind == volume ]] ||
                    die "already set up in the Syncthing on this host; add --use-host-syncthing, or run uninstall first"
                die "the Syncthing on this host already syncs claude-sync's folder; to sync this volume beside it, set CLAUDE_SYNC_NAME to another name"
            elif [[ $kind == path ]] && paths_overlap "$real_target" "$(real_path "$fpath")"; then
                die "this host's Syncthing folder $fid already syncs $fpath, which overlaps $target; choose another directory"
            fi
        done < <(host_folders)
    fi

    local mount
    if [[ $kind == volume ]]; then
        check_volume "$target"
        mount="type=volume,src=$target,dst=/target"
    else
        # Not checked with -d: Docker resolves the path on its host, which is not this
        # filesystem when claude-sync runs inside a container sharing the host's daemon.
        # --mount takes comma-separated fields, with no quoting for a comma in a value.
        [[ $target != *,* ]] || die "paths containing a comma are not supported: $target"
        mount="type=bind,src=$target,dst=/target"
    fi

    local current
    current=$(current_target "$name") || current=""
    [[ -z $current || $current == "$target" ]] || die "already set up for $current; run uninstall first"
    # Two Syncthings on one target would each sync it as a device of its own.
    local taken
    taken=$(target_taken_by "$target")
    [[ -z $taken ]] || die "container $taken already syncs $target; give this instance another target"

    local image
    image=$(compose_image)
    owner=$(read_owner "$image" "$mount" "$target")

    local created_config=""
    if docker volume inspect "$name-config" >/dev/null 2>&1; then
        ours_volume "$name-config" || die "volume $name-config exists but was not created by claude-sync"
    else
        docker volume create --label "$label" "$name-config" >/dev/null
        created_config=1
    fi
    # A new volume's root belongs to root and the image chowns only its home directory,
    # so without this Syncthing cannot write its config as the target's owner.
    docker run --rm --entrypoint chown --mount "type=volume,src=$name-config,dst=/config" \
        "$image" -R "$owner" /config
    companion_script | docker run --rm -i --user "$owner" --entrypoint sh \
        --mount "type=volume,src=$name-config,dst=/config" "$image" -c 'cat >/config/claude-sync-companion'

    export CLAUDE_SYNC_UID=${owner%:*} CLAUDE_SYNC_GID=${owner#*:} CLAUDE_SYNC_TARGET=$target
    # Compose reads only files; the port checks and `up` below use them.
    local compose_dir
    compose_dir=$(mktemp -d -t claude-sync.XXXXXX)
    # shellcheck disable=SC2064 # expanded now: compose_dir is local
    trap "rm -rf -- $(printf %q "$compose_dir")" EXIT
    asset compose.yaml >"$compose_dir/compose.yaml"
    asset "compose.$kind.yaml" >"$compose_dir/compose.$kind.yaml"
    compose_files=(-f "$compose_dir/compose.yaml" -f "$compose_dir/compose.$kind.yaml")
    [[ -z ${CLAUDE_SYNC_COMPOSE_OVERRIDE:-} ]] || compose_files+=(-f "$CLAUDE_SYNC_COMPOSE_OVERRIDE")

    # A port asked for must be free, unless this instance already has it.
    local port status
    for port in $want_gui $want_sync; do
        if running && [[ $port == "$(gui_port)" || $port == "$(sync_port)" ]]; then
            continue
        fi
        status=0
        port_free "$port" || status=$?
        if ((status != 0)); then
            [[ -z $created_config ]] || docker volume rm "$name-config" >/dev/null
            ((status == 1)) || die "cannot check port $port: $probe_error"
            die "port $port is in use; choose another"
        fi
    done

    # Written before Syncthing first scans the folder, so ignored files are never indexed.
    asset stignore | docker run --rm -i --user "$owner" --entrypoint sh --mount "$mount" "$image" \
        -c 'cat >/target/.stignore'

    compose up --detach --wait --wait-timeout 120 --quiet-pull

    # A web UI on the sync port would leave nothing to reach Syncthing through, so the two
    # are checked as they will end up. The web UI moves first when the sync port takes its
    # port, or the sync listener would wait on Syncthing's retry; not in an exact swap,
    # where the web UI would move onto the port the sync listener still holds and setup
    # would lose the API.
    local gui sync current_gui
    { current_gui=$(gui_port) && gui=${want_gui:-$current_gui} && sync=${want_sync:-$(sync_port)}; } ||
        die "cannot reach Syncthing in container $name"
    [[ $gui != "$sync" ]] || die "the web UI and sync ports would both be $gui; choose different ones"
    if [[ $sync == "$current_gui" && $gui != "$(sync_port)" ]]; then
        move_gui_port "$want_gui"
        move_sync_port "$want_sync"
    else
        move_sync_port "$want_sync"
        move_gui_port "$want_gui"
    fi

    ensure_folder
    # Left as it is when neither is given, so re-running setup never makes a device public.
    if [[ -n $network ]]; then
        local option on=true
        [[ $network == public ]] || on=false
        for option in global-ann-enabled relays-enabled natenabled; do
            st config options "$option" set "$on"
        done
    fi
    wait_folder_started

    { gui=$(gui_port) && sync=$(sync_port); } || die "cannot reach Syncthing in container $name"
    printf 'Syncthing is running in container %s, web UI on 127.0.0.1:%s, sync port %s.\n' \
        "$name" "$gui" "$sync"
    tell_busy
    # A new config volume is Syncthing's first start, when it takes free ports in place of
    # busy defaults.
    if [[ -n $created_config ]] && { [[ -z $want_gui && $gui != "$default_gui_port" ]] ||
        [[ -z $want_sync && $sync != "$default_sync_port" ]]; }; then
        echo "Another program holds Syncthing's default web UI or sync port, so this instance uses a free one instead."
        if [[ $kind == path && $name == "$default_name" ]]; then
            echo "If that program is your own Syncthing, run uninstall, then setup again with --use-host-syncthing to use it."
        fi
    fi
    printf 'This device ID: %s\n' "$(docker exec -u "$owner" "$name" syncthing device-id)"
    schedule_backup "$backup"
    write_stamp "$name" container
}

check_volume() {
    # `docker run --mount` would silently create a missing volume.
    docker volume inspect "$1" >/dev/null 2>&1 || die "no Docker volume named $1"
}

compose_image() {
    local image
    image=$(asset compose.yaml | sed -n 's/^ *image: *//p')
    [[ -n $image ]] || die "no image in compose.yaml"
    echo "$image"
}

# Prints the UID:GID that owns a target, or dies if it cannot read the target or root owns
# it. Takes IMAGE, the MOUNT that puts the target at /target, and TARGET, the target's name
# in messages.
read_owner() {
    local owner
    owner=$(docker run --rm --entrypoint stat --mount "$2" "$1" -c %u:%g /target) ||
        die "cannot read $3"
    # Files written as root are files Claude Code cannot change.
    [[ ${owner%:*} != 0 ]] || die "$3 is owned by root; chown it to the user who runs Claude Code"
    echo "$owner"
}

# Moves the sync port to PORT, if given and new.
move_sync_port() {
    [[ -n $1 && $1 != "$(sync_port)" ]] || return 0
    # Replaces all listen addresses; the relay one is Syncthing's default, and --private
    # keeps relays off through its own option.
    rest /rest/config/options -X PATCH -H 'Content-Type: application/json' \
        -d "{\"listenAddresses\": [\"tcp://:$1\", \"quic://:$1\", \"dynamic+https://relays.syncthing.net/endpoint\"]}" \
        >/dev/null || die "cannot set the sync port"
}

# Moves the web UI to PORT, if given and new.
move_gui_port() {
    [[ -n $1 && $1 != "$(gui_port)" ]] || return 0
    # The web UI moves at once, so this call may not get its answer.
    st config gui raw-address set "127.0.0.1:$1" 2>/dev/null || true
    wait_reachable || die "Syncthing's web UI did not come up on port $1"
}

# After an exact port swap, Syncthing's API takes tens of seconds to come back.
wait_reachable() {
    local i
    for ((i = 0; i < 60; i++)); do
        st show version >/dev/null 2>&1 && return 0
        sleep 1
    done
    return 1
}

setup_host() {
    local target=$1 backup=$2
    [[ -d $target ]] || die "no directory $target"
    # Stored absolute, without a trailing slash or `..`.
    target=$(cd -- "$target" && pwd)
    if command -v docker >/dev/null && docker container inspect "$name" >/dev/null 2>&1; then
        die "already set up in container $name; run uninstall first"
    fi
    use_host
    local version
    version=$(st show version | field version)
    if ! [[ $version =~ ^v([0-9]+)\. ]] || ((BASH_REMATCH[1] < 2)); then
        die "this host runs Syncthing $version; claude-sync needs Syncthing 2 or newer"
    fi
    local id path real real_target
    # A folder inside or around another would sync the same files twice, and the join's
    # undo would reach the other folder's devices.
    real_target=$(real_path "$target")
    while IFS= read -r id; do
        path=$(st config folders "$id" path get)
        real=$(real_path "$path")
        if [[ $id == "$folder_id" ]]; then
            [[ $real == "$real_target" ]] || die "already set up for $path; run uninstall first"
        elif paths_overlap "$real_target" "$real"; then
            die "this host's Syncthing folder $id already syncs $path, which overlaps $target; choose another directory"
        fi
    done < <(st config folders list)
    folder_path=$target
    # Here as well as in schedule_backup, so that a refused DIR leaves the folder unadded.
    [[ $backup != /* ]] || check_outside_synced_folder "$backup"

    # Before the folder is added, as in setup.
    asset stignore >"$target/.stignore"
    ensure_folder
    wait_folder_started
    apply_unpaired
    tell_busy

    printf 'The Syncthing on this host syncs %s.\nThis device ID: %s\n' "$target" "$(syncthing_run device-id)"
    schedule_backup "$backup"
    write_stamp "$name" host
}

pair() {
    local id="" keep="" address=dynamic
    while (($#)); do
        case $1 in
            --keep) keep=1 ;;
            --address)
                (($# >= 2)) || die "$1 needs a value"
                address=$2
                shift
                ;;
            -*) die "unknown argument: $1" ;;
            *)
                [[ -z $id ]] || die "unknown argument: $1"
                id=$1
                ;;
        esac
        shift
    done
    if [[ -z $id ]]; then
        usage >&2
        exit 2
    fi
    check_instance
    detect_mode

    [[ $id =~ $id_re ]] || die "not a device ID: $id; copy it as setup printed it"
    local self
    self=$(syncthing_run device-id)
    [[ $id != "$self" ]] || die "that is this device's own ID; give the other device's"
    [[ $address != dynamic || $(st config options global-ann-enabled get) == true ]] ||
        die "this device is private: give the other device's --address, such as tcp://HOST:22000"
    # Also keeps the address safe to put in the JSON below.
    local address_re='^[a-z0-9]+://[^"\\[:space:][:cntrl:]]+$' at="" there=""
    if [[ $address != dynamic ]]; then
        [[ $address =~ $address_re ]] || die "not an address: $address; give one such as tcp://HOST:22000"
        local port
        port=$(sync_port) || die "cannot reach Syncthing $where"
        at=" --address $address" there=" --address tcp://THIS-HOST:$port"
    fi

    # Before the folder changes below, so a bad ID changes nothing. A device added here but
    # not yet shared with gets no data.
    local devices known="" err
    devices=$(st config devices list)
    if grep -qxF -- "$id" <<<"$devices"; then
        known=1
    fi
    local syncing
    syncing=$(st config folders "$folder_id" devices list 2>/dev/null | grep -cvxF -- "$self") || true
    # A joining device's folder never sends its changes, so the ID could not leave the list.
    # shellcheck disable=SC2016 # expanded by sh
    if in_folder '[ -e "$1" ]' sh "$folder_path/$unpaired_dir/$id" &&
        [[ $(st config folders "$folder_id" type get 2>/dev/null) == receiveonly ]]; then
        die "$id is on the list of unpaired devices, which this joining device cannot change; pair it from a device that already syncs first"
    fi
    forget_unpaired "$id"
    # A device set up again on files that list it would otherwise unpair itself everywhere.
    # One that still syncs with others was unpaired on purpose, and taking it off the list
    # there would undo that through any device that has not dropped it yet.
    ((syncing != 0)) || forget_unpaired "$self"
    err=$(st config devices add --device-id "$id" --addresses "$address" 2>&1) ||
        die "cannot add device $id: $err"
    # Adding a known device changes nothing (Syncthing 2.1.6), so a corrected address is
    # set here.
    if [[ -n $known && $address != dynamic ]]; then
        rest "/rest/config/devices/$id" -X PATCH -H 'Content-Type: application/json' \
            -d "{\"addresses\": [\"$address\"]}" >/dev/null || die "cannot set the address of $id"
    fi

    # A device syncing with no other yet is the one being added, so it joins; receive-only
    # means a join was interrupted.
    local type sharing shared join=""
    type=$(st config folders "$folder_id" type get 2>/dev/null) || die "no $folder_id folder; run setup first"
    sharing=$(st config folders "$folder_id" devices list)
    shared=$(grep -cvxF -- "$self" <<<"$sharing") || true
    if [[ $type == receiveonly && -n $keep ]]; then
        # Ends the interrupted join without discarding anything, as --keep promises.
        st config folders "$folder_id" type set sendreceive
    elif [[ $type == receiveonly ]]; then
        join=1
    elif ((shared == 0)) && [[ -z $keep ]]; then
        join=1
        # In Syncthing 2.1.6, files indexed while send-receive are still sent as this
        # device's changes after a switch to receive-only.
        # Re-added receive-only, the folder indexes them as local changes, which are never
        # sent and are undone once caught up.
        st config folders "$folder_id" delete
        add_folder receiveonly
    fi

    # Every device introduces the devices it syncs with to the others, so a device can
    # join through any of them. An introducer's devices join every folder shared with it,
    # so on the host's Syncthing a device sharing other folders is not made one.
    if [[ $mode == host ]] && shares_other_folder "$id"; then
        printf '%s also syncs other folders with this Syncthing, so claude-sync does not make it an introducer: pair this device with each of the others too.\n' "$id"
    else
        st config devices "$id" introducer set true
    fi
    prints_line "$id" st config folders "$folder_id" devices list ||
        st config folders "$folder_id" devices add --device-id "$id"
    if [[ -z $join ]]; then
        printf 'Paired with %s. If not done yet, run there: claude-sync pair %s%s\n' "$id" "$self" "$there"
        return
    fi

    join_wait "$id" "$self" "$there" first
    # Joining devices with no files would only discard this device's: likely the first
    # pairing of a new set, missing --keep. Read twice, since the other device's index can
    # arrive just after it starts sharing. Nothing here was sent while receive-only, so
    # undoing the pairing restores the device as it was.
    if nothing_to_join && sleep 5 && nothing_to_join; then
        st config folders "$folder_id" devices "$id" delete
        [[ -n $known ]] || st config devices "$id" delete
        st config folders "$folder_id" type set sendreceive
        die "$id has no files to join, so joining would only discard this device's; undone, nothing was discarded. If this device's files are the ones to start from, rerun: claude-sync pair $id$at --keep"
    fi
    # Undo what changed here, then wait for the undone files to be pulled again: switching
    # to send-receive before they arrive would send this device's copies. Repeated while
    # something here, such as a running Claude Code, keeps changing files.
    set_trash_can
    local status rounds
    for ((rounds = 1; ; rounds++)); do
        undo_changes
        join_wait "$id" "$self" "$there"
        status=$(folder_status) || die "cannot reach Syncthing $where; rerun to finish the join"
        [[ $(field receiveOnlyTotalItems <<<"$status") != 0 ]] || break
        ((rounds < 5)) || die "files here keep changing during the join; stop Claude Code on this device and rerun"
    done
    st config folders "$folder_id" type set sendreceive
    printf 'Joined through %s; this device now syncs both ways.\n' "$id"
}

shares_other_folder() {
    local f
    while IFS= read -r f; do
        [[ $f != "$folder_id" ]] || continue
        prints_line "$1" st config folders "$f" devices list && return 0
    done < <(st config folders list)
    return 1
}

# Until this device has the folder as the device joined through has it. With FIRST, only as
# far as it can before its own changes are undone: a directory deleted there fails to go
# while it holds files of this device's own.
join_wait() {
    local id=$1 self=$2 there=$3 first=${4:-} told="" failures=0 polls=0 remote status state need
    local errors failing
    while :; do
        if ! status=$(folder_status) ||
            ! remote=$(rest "/rest/db/completion?folder=$folder_id&device=$id" | field remoteState); then
            ((++failures < 15)) || die "cannot reach Syncthing $where; rerun to finish the join"
            sleep 2
            continue
        fi
        failures=0
        state=$(field state <<<"$status")
        [[ $state != error ]] || die "Syncthing cannot sync the folder: $(field error <<<"$status")"
        need=$(field needTotalItems <<<"$status")
        if [[ $remote == valid ]]; then
            errors=$(field errors <<<"$status")
            if [[ $state == idle ]]; then
                [[ $need != 0 ]] || return 0
                # All that is left fails to sync: as far as FIRST goes.
                [[ -z $first || $need != "${errors:-0}" ]] || return 0
            fi
            if ((++polls % 15 == 0)) && [[ $need != 0 ]]; then
                failing=""
                [[ ${errors:-0} == 0 ]] || failing=", $errors failing ($(web_ui) shows why)"
                echo "Still syncing: $need files and directories to go$failing."
            fi
        elif [[ -z $told ]]; then
            printf 'Waiting for %s; if not done yet, run there: claude-sync pair %s%s\n' "$id" "$self" "$there"
            told=1
        fi
        sleep 2
    done
}

# Reverts this device's receive-only changes until none are left. Not the CLI's
# folder-override, which leaves a receive-only folder's changes in place (2.1.6).
undo_changes() {
    local status i
    for ((i = 0; ; i++)); do
        status=$(folder_status) || die "cannot reach Syncthing $where; rerun to finish the join"
        [[ $(field receiveOnlyTotalItems <<<"$status") != 0 ]] || return 0
        ((i < 60)) || die "this device's own changes are still not undone after two minutes, so the join cannot finish; Syncthing's web UI at $(web_ui) shows what is left. Until the join finishes, this device gets the other devices' changes but sends none of its own. Rerun to try again."
        rest "/rest/db/revert?folder=$folder_id" -X POST >/dev/null ||
            die "cannot reach Syncthing $where; rerun to finish the join"
        sleep 2
    done
}

# The device joined through has no files, while this device has changes to undo.
nothing_to_join() {
    local status
    status=$(folder_status) || die "cannot reach Syncthing $where; rerun to finish the join"
    [[ $(field globalTotalItems <<<"$status") == 0 && $(field receiveOnlyTotalItems <<<"$status") != 0 ]]
}

unpair() {
    if (($# != 1)); then
        usage >&2
        exit 2
    fi
    local id=$1 self
    check_instance
    detect_mode
    [[ $id =~ $id_re ]] || die "not a device ID: $id; copy it as setup printed it"
    self=$(syncthing_run device-id)
    [[ $id != "$self" ]] || die "that is this device's own ID; run unpair with it on another device"
    # A receive-only folder never sends the list, and the join's undo would remove it.
    [[ $(st config folders "$folder_id" type get) != receiveonly ]] ||
        die "this device is still joining; finish that with pair first"
    # shellcheck disable=SC2016 # expanded by sh
    in_folder 'mkdir -p "$1" && : >"$1/$2"' sh "$folder_path/$unpaired_dir" "$id"
    apply_unpaired
    printf 'Unpaired %s here. The other devices drop it as the list of unpaired devices reaches them; one using its own Syncthing does so the next time claude-sync runs there. Once they all refuse %s, it stops syncing; run uninstall on it to remove its state.\n' "$id" "$id"
}

uninstall() {
    (($# == 0)) || die "uninstall takes no arguments"
    check_instance
    local container="" volume=""
    if command -v docker >/dev/null; then
        if docker container inspect "$name" >/dev/null 2>&1; then
            ours_container "$name" || die "container $name was not created by claude-sync; not removing it"
            container=1
        fi
        if docker volume inspect "$name-config" >/dev/null 2>&1; then
            ours_volume "$name-config" || die "volume $name-config was not created by claude-sync; not removing it"
            volume=1
        fi
    fi
    check_unschedule
    if [[ -n $container ]]; then
        # -v: the image declares a volume, left behind otherwise. Volumes mounted by name,
        # such as the synced one, are kept.
        docker rm --force -v "$name" >/dev/null
        echo "Removed container $name."
    fi
    if [[ -n $volume ]]; then
        docker volume rm "$name-config" >/dev/null
        echo "Removed volume $name-config (this device's Syncthing identity)."
    fi
    if [[ -z $container && $name == "$default_name" ]] && host_syncthing_configured; then
        use_host
        if prints_line "$folder_id" st config folders list; then
            folder_path=$(st config folders "$folder_id" path get)
            apply_unpaired
            st config folders "$folder_id" delete
            local file
            file=$(stamp_file host) && rm -f -- "$file"
            echo "Removed the $folder_id folder from the Syncthing on this host; its other folders stay, and so do its devices, apart from unpaired ones that share no other folder."
        fi
    fi
    unschedule_backup
    echo "The synced files are untouched."
    if [[ $(selected_instance) == "$name" ]]; then
        rm -f -- "$(selection_file)"
        echo "Instance $name is no longer selected; later commands act on the default instance, $default_name."
    fi
}

# Lists this host's instances, marking the one commands act on.
list() {
    (($# == 0)) || die "list takes no arguments"
    local all unlisted="" instance status width=4 mark state syncs marked="" tab=$'\t'
    all=$(instances) || unlisted=1
    while IFS=$'\t' read -r instance status; do
        ((${#instance} <= width)) || width=${#instance}
    done <<<"$all"
    if [[ -n $all ]]; then
        printf '  %-*s  %-14s  %s\n' "$width" NAME STATE SYNCS
        while IFS=$'\t' read -r instance status; do
            mark=" "
            if [[ $instance == "$name" ]]; then
                mark="*" marked=1
            fi
            case $status in
                container | stopped)
                    state=running
                    [[ $status == container ]] || state=stopped
                    syncs=$(current_target "$instance") || syncs=""
                    if [[ $syncs == /* ]]; then
                        syncs="directory $syncs"
                    elif [[ -n $syncs ]]; then
                        syncs="volume $syncs"
                    fi
                    ;;
                state-only) state="state only" syncs="" ;;
                host)
                    state="host Syncthing"
                    syncs="directory $(host_folders | sed -n "s/^$folder_id$tab//p")"
                    ;;
            esac
            printf '%s %-*s  %-14s  %s\n' "$mark" "$width" "$instance" "$state" "${syncs:--}"
        done <<<"$all"
    fi
    [[ -z $unlisted ]] ||
        die "docker cannot list the instances in containers, so this list leaves them out; once docker works, rerun claude-sync list"
    [[ -n $marked ]] || check_name
    if [[ -z $all ]]; then
        echo "No instance is set up on this host."
    elif [[ -z $marked ]]; then
        echo "Commands act on instance $name, which is not set up on this host."
    fi
}

# Selects the instance later commands act on, when CLAUDE_SYNC_NAME is unset.
use() {
    if (($# != 1)); then
        usage >&2
        exit 2
    fi
    local instance=$1 file all
    file=$(selection_file) ||
        die "neither HOME nor an absolute XDG_CONFIG_HOME is set, so there is nowhere to keep the selection"
    if [[ $instance == "$default_name" ]]; then
        rm -f -- "$file" 2>/dev/null || die "cannot remove $file, which holds the selection"
        echo "Commands now act on the default instance, $default_name."
    else
        all=$(instances) || die "docker cannot list the instances in containers, so use cannot check that $instance is one; once docker works, rerun claude-sync use $instance"
        if ! valid_name "$instance" || ! prints_line "$instance" cut -f 1 <<<"$all"; then
            die "no instance named $instance on this host; claude-sync list shows them"
        fi
        { mkdir -p -- "${file%/*}" && printf '%s\n' "$instance" >"$file"; } 2>/dev/null ||
            die "cannot write the selection to $file"
        echo "Commands now act on instance $instance."
    fi
    if [[ $name_from == variable && $name != "$instance" ]]; then
        echo "CLAUDE_SYNC_NAME is set, so commands run with it still act on instance $name."
    fi
}

upgrade() {
    (($# == 0)) || die "upgrade takes no arguments"
    [[ $claude_sync_version != dev ]] ||
        die "this claude-sync runs from a checkout (version dev); update it with git, then run setup to apply it"
    local file
    file=$(readlink -f -- "${BASH_SOURCE[0]}")
    if command -v rpm >/dev/null && rpm -qf -- "$file" >/dev/null 2>&1; then
        die "$file belongs to the RPM package $(rpm -qf -- "$file"): upgrade it with dnf as you installed it, then run CLAUDE_SYNC_NAME=NAME claude-sync setup for each running instance NAME that claude-sync list shows"
    fi
    command -v curl >/dev/null || die "curl is required"
    command -v sha256sum >/dev/null || die "sha256sum is required"
    check_releases
    if [[ -n $release_safe ]]; then
        install_release "$release_safe" "$file"
        echo "Installed claude-sync ${release_safe#v} in place of $claude_sync_version."
        # The new version applies itself, and tells of any breaking release. It does not exec
        # again unless a newer release came out between the two fetches of the list:
        # install_release checked that it is release_safe, the newest release that is not
        # breaking.
        exec "$file" upgrade
    fi
    if [[ -n $release_breaking ]]; then
        printf 'claude-sync %s is out. It is a breaking release, so upgrade leaves it to you; its release notes say how to upgrade: %s\n' \
            "${release_breaking#v}" "$(release_url "$release_breaking")"
    fi
    apply_everywhere "$file"
}

# Downloads the release TAG's claude-sync, checks it against the release's SHA-256, and puts
# it in place of FILE as a new file, so a command still running the old one is unaffected.
install_release() {
    local tag=$1 file=$2 url sums tmp want
    { url=$(release_url "$tag" claude-sync) && sums=$(release_url "$tag" claude-sync.sha256); } ||
        die "release $tag has no claude-sync or claude-sync.sha256 to download"
    # In FILE's directory, so the move is a rename that replaces FILE at once.
    tmp=$(mktemp -- "${file%/*}/.claude-sync.XXXXXX") || die "cannot write to ${file%/*}, where claude-sync is"
    # shellcheck disable=SC2064 # expanded now: tmp is local
    trap "rm -f -- $(printf %q "$tmp")" EXIT
    curl -fsSL -o "$tmp" -- "$url" || die "cannot download $url"
    want=$(curl -fsSL -- "$sums") || die "cannot download $sums"
    [[ $(sha256sum <"$tmp") == "${want%% *} "* ]] ||
        die "the claude-sync downloaded from $url does not match the release's SHA-256; nothing was changed"
    chmod 755 "$tmp"
    # A file that gave another version would find this release newer than itself again.
    [[ $(bash "$tmp" version) == "claude-sync ${tag#v}" ]] ||
        die "the claude-sync downloaded from $url is not version ${tag#v}; nothing was changed"
    mv -f -- "$tmp" "$file"
}

# Runs FILE's setup, with no target, for every running instance that an older version set
# up, carrying on past one that fails.
apply_everywhere() {
    local file=$1 all instance status version unlisted="" found="" running="" applied="" failed=()
    all=$(instances) || unlisted=1
    while IFS=$'\t' read -r instance status; do
        [[ -n $instance ]] || continue
        found=1
        case $status in
            stopped)
                printf 'Instance %s is stopped, so upgrade leaves it stopped; %s starts it with claude-sync %s.\n' \
                    "$instance" "$(setup_command "$instance")" "$claude_sync_version"
                continue
                ;;
            state-only)
                printf 'Volume %s-config holds the Syncthing state of instance %s, which no container of claude-sync uses; %s --volume NAME or --path DIR uses it again.\n' \
                    "$instance" "$instance" "$(setup_command "$instance")"
                continue
                ;;
        esac
        # What is left, container or host, is also where the instance's Syncthing runs, the
        # place instance_version and setup's write_stamp take.
        running=1
        version=$(instance_version "$instance" "$status") || version=""
        stale "$version" || continue
        applied=1
        printf 'Applying claude-sync %s to instance %s:\n' "$claude_sync_version" "$instance"
        # Its stdin would otherwise be the rest of the list.
        CLAUDE_SYNC_NAME=$instance "$file" setup </dev/null || failed+=("$instance")
    done <<<"$all"
    if [[ -n $unlisted ]]; then
        # A daemon that is not running, or a user outside the docker group, would otherwise
        # pass for a host with no instance in a container.
        printf 'claude-sync: docker cannot list the instances in containers, so none of those was upgraded; once docker works, rerun claude-sync upgrade\n' >&2
    elif [[ -z $found ]]; then
        echo "claude-sync $claude_sync_version is installed; no instance is set up on this host yet."
    elif [[ -n $running && -z $applied ]]; then
        echo "Every running instance already runs claude-sync $claude_sync_version."
    fi
    case ${#failed[@]} in
        0) [[ -z $unlisted ]] || exit 1 ;;
        1) die "setup failed for instance ${failed[0]}; fix what it says, then rerun claude-sync upgrade" ;;
        *) die "setup failed for instances ${failed[*]}; fix what each says, then rerun claude-sync upgrade" ;;
    esac
}

backup() {
    local dir="" weekly=4 monthly=6
    while (($#)); do
        case $1 in
            --keep-weekly | --keep-monthly)
                (($# >= 2)) || die "$1 needs a value"
                [[ $2 =~ ^[0-9]{1,4}$ ]] || die "$1 takes a number of archives, from 0 to 9999: $2"
                if [[ $1 == --keep-weekly ]]; then weekly=$((10#$2)); else monthly=$((10#$2)); fi
                shift 2
                ;;
            -*) die "unknown argument: $1" ;;
            *)
                [[ -z $dir ]] || die "unknown argument: $1"
                dir=$1
                shift
                ;;
        esac
    done
    if [[ -z $dir ]]; then
        usage >&2
        exit 2
    fi
    # A quoted ~: left as it is, mkdir would make ./~ here and write the archive into it.
    dir=$(expand_home "$dir")
    check_instance
    detect_mode
    # Each archive would sync to every device and hold the ones before it. Checked before
    # mkdir, whose directory would sync too.
    check_outside_synced_folder "$dir"
    mkdir -p -- "$dir"
    local archive tmp
    # remove_stopped_backups and prune match this name's format again, and stop finding the
    # archives if it changes here alone.
    archive=$dir/$name-$(date -u +%Y%m%dT%H%M%SZ).tar.gz
    [[ ! -e $archive ]] || die "$archive already exists; rerun in a second"
    # Written under another name until whole, so no half-written archive passes for one.
    # Redirection, unlike mktemp, gives it the umask's mode: archives are ordinary files,
    # meant to be copied to other devices.
    tmp=$dir/.${archive##*/}.$$
    # shellcheck disable=SC2064 # expanded now: tmp is local
    trap "rm -f -- $(printf %q "$tmp")" EXIT
    write_archive "$tmp"
    mv -- "$tmp" "$archive"
    trap - EXIT
    echo "Backed up to $archive."
    remove_stopped_backups "$dir"
    prune "$dir" "$archive" "$weekly" "$monthly"
}

# Writes a gzip tar of the synced folder to FILE, or dies.
write_archive() {
    local errors status=0
    # FILE is opened under noclobber: its name can be guessed, so in a DIR that others can
    # write, a file planted at it, or a symlink to one, stops the backup instead of being
    # overwritten.
    if [[ $mode == host ]]; then
        # In English, which only_files_that_changed reads.
        errors=$(set -C; LC_ALL=C tar -C "$folder_path" -czf - . 2>&1 >"$1") || status=$?
    else
        errors=$(set -C; docker exec -u "$owner" "$name" tar -C "$folder_path" -czf - . 2>&1 >"$1") || status=$?
    fi
    [[ -z $errors ]] || printf '%s\n' "$errors" >&2
    if ((status == 1)) && only_files_that_changed "$errors"; then
        status=0
    fi
    ((status == 0)) || die "tar could not archive the synced folder; its message is above"
}

# Dies if DIR, or the directory mkdir -p would make of it, is the synced folder or in it.
check_outside_synced_folder() {
    if [[ $mode == host ]]; then
        path_within "$(planned_path "$1")" "$(real_path "$folder_path")" || return 0
    else
        # The container's folder is a volume or a path on the Docker host, which may not be
        # this machine, so no path here compares with it. A file made in DIR's nearest
        # existing directory is looked for from inside the container instead.
        local probe out errors status=0
        probe=$(nearest_dir "$1")/.$name-probe.$$
        # Made under noclobber, as write_archive makes the archive.
        if ! (set -C; : >"$probe") 2>/dev/null; then
            # Not writable: then backup cannot make DIR or write in it either, and fails there.
            [[ -e $probe || -L $probe ]] || return 0
            die "$probe is in the way; remove it and rerun"
        fi
        # In a subshell, so this EXIT trap leaves the caller's in place.
        out=$(
            # shellcheck disable=SC2064 # expanded now: probe is local
            trap "rm -f -- $(printf %q "$probe")" EXIT
            docker exec -u "$owner" "$name" find "$folder_path" -name "${probe##*/}" 2>&1
        ) || status=$?
        # The paths find matched start with a slash; every other line is a message.
        errors=$(grep -v '^/' <<<"$out") || true
        [[ -z $errors ]] || printf '%s\n' "$errors" >&2
        if ((status == 1)) && only_paths_that_went "$errors"; then
            status=0
        fi
        ((status == 0)) || die "could not search the synced folder for $1; find's message is above"
        grep -q '^/' <<<"$out" || return 0
    fi
    die "$1 is in the synced folder; give backup a directory outside it"
}

# Removes the temporary files that this instance's backups into DIR left there when stopped
# before their EXIT trap ran, by SIGKILL or a power cut. One untouched for a day is no longer
# being written.
remove_stopped_backups() {
    local stopped
    while IFS= read -r stopped; do
        rm -f -- "$stopped"
        echo "Removed $stopped."
    done < <(find "$1" -maxdepth 1 -type f -mmin +1440 \
        -name ".$name-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z.tar.gz.*")
}

# Whether each line tar printed, given as ERRORS, says only that a file changed or went while
# tar read the folder, as Claude Code's and Syncthing's temporary files do. tar exits 1 then
# and still archives the rest of the folder whole. GNU tar says "file changed as we read it"
# or "File removed before we read it"; BusyBox names the file with "No such file or
# directory", then adds "error exit delayed from previous errors". Any other line fails the
# backup, among them GNU's "File shrank", for a file it pads with zeros, and BusyBox's "short
# read", for an archive it cuts short.
only_files_that_changed() {
    ! grep -qvE \
        -e '^tar: \.(/.*)?: (file changed as we read it|File removed before we read it)$' \
        -e "^tar: (\./.*|can't open '\./.*'): No such file or directory\$" \
        -e '^tar: error exit delayed from previous errors$' <<<"$1"
}

# Whether each line find printed, given as ERRORS, says only that a path under the folder
# went while find walked it. BusyBox's find exits 1 for a file that goes between listing its
# directory and reading it, the race that only_files_that_changed passes for tar.
only_paths_that_went() {
    ! grep -qvE "^find: $folder_path/.*: No such file or directory\$" <<<"$1"
}

# Removes this instance's archives in DIR that neither rule keeps: the newest archive of each
# of the last WEEKLY weeks that have one, and the same for the last MONTHLY months. Counting
# only weeks and months with archives means archives never all age out while backups stop.
# The time comes from each name, which copying keeps, unlike the mtime. KEEP, the archive
# just written, always stays.
prune() {
    local dir=$1 keep=$2 weekly=$3 monthly=$4 files i f kept week month
    local last_week="" last_month="" weeks=0 months=0
    local re="^$name-([0-9]{4})([0-9]{2})([0-9]{2})T[0-9]{6}Z\.tar\.gz\$"
    files=("$dir/$name"-*.tar.gz)
    # Newest first: the names sort by time.
    for ((i = ${#files[@]} - 1; i >= 0; i--)); do
        f=${files[i]}
        [[ ${f##*/} =~ $re ]] || continue
        week=$(week_number "${BASH_REMATCH[@]:1}")
        month=${BASH_REMATCH[1]}${BASH_REMATCH[2]}
        kept=""
        [[ $f != "$keep" ]] || kept=1
        if [[ $week != "$last_week" ]]; then
            last_week=$week
            if ((++weeks <= weekly)); then kept=1; fi
        fi
        if [[ $month != "$last_month" ]]; then
            last_month=$month
            if ((++months <= monthly)); then kept=1; fi
        fi
        if [[ -z $kept ]]; then
            rm -- "$f"
            echo "Removed $f."
        fi
    done
}

# The week of the date YYYY MM DD, counted in weeks from Monday to Sunday since 1970: days
# since 1970-01-01, a Thursday, by Howard Hinnant's days_from_civil, in bash alone since
# `date -d` differs between systems.
week_number() {
    local y=$((10#$1)) m=$((10#$2)) d=$((10#$3)) era yoe doy doe
    y=$((y - (m <= 2)))
    era=$((y / 400))
    yoe=$((y - era * 400))
    doy=$(((153 * (m > 2 ? m - 3 : m + 9) + 2) / 5 + d - 1))
    doe=$((yoe * 365 + yoe / 4 - yoe / 100 + doy))
    echo $(((era * 146097 + doe - 719468 + 3) / 7))
}

restore() {
    local archive="" kind="" target=""
    while (($#)); do
        case $1 in
            --volume | --path)
                [[ -z $kind ]] || die "give only one of --volume or --path"
                (($# >= 2)) || die "$1 needs a value"
                kind=${1#--} target=$2
                shift 2
                ;;
            -*) die "unknown argument: $1" ;;
            *)
                [[ -z $archive ]] || die "unknown argument: $1"
                archive=$1
                shift
                ;;
        esac
    done
    if [[ -z $archive || -z $kind ]]; then
        usage >&2
        exit 2
    fi
    # A quoted ~, as backup takes one: left as it is, --path would make ./~ here and restore
    # into it.
    archive=$(expand_home "$archive")
    [[ $kind == volume ]] || target=$(expand_home "$target")
    [[ -f $archive ]] || die "no file $archive"
    # A volume is written in a container, as the volume's owner; a directory here, with this
    # machine's tar, as the user running claude-sync.
    local untar dest own=()
    if [[ $kind == volume ]]; then
        command -v docker >/dev/null || die "Docker is required"
        check_volume "$target"
        local image owner mount="type=volume,src=$target,dst=/target"
        image=$(compose_image)
        owner=$(read_owner "$image" "$mount" "$target")
        untar=(docker run --rm -i --user "$owner" --mount "$mount" --entrypoint tar "$image")
        dest=/target
    else
        untar=(tar)
        dest=$target
        # tar run by root keeps the archive's owners unless told not to.
        own=(--no-same-owner)
    fi
    # Read through first, so a damaged archive writes nothing, not even --path's DIR.
    "${untar[@]}" -tzf - <"$archive" >/dev/null || die "cannot read $archive as a backup; nothing was restored"
    [[ $kind == volume ]] || mkdir -p -- "$target"
    "${untar[@]}" -xzf - -C "$dest" "${own[@]}" <"$archive" ||
        die "could not restore all of $archive to $target; tar's message is above"
    echo "Restored $archive to $target."
}

# Whether this user has a systemd user manager to run the daily backup. Read from the state
# it prints, as its exit status is not 0 for a degraded manager, one with a failed unit, and
# some containers have a systemctl that only prints a notice.
user_systemd() {
    case $(systemctl --user is-system-running 2>/dev/null) in
        running | degraded | starting | initializing | maintenance) ;;
        *) return 1 ;;
    esac
}

# systemctl --user ARGS, silent unless it fails.
user_systemctl() {
    local out
    out=$(systemctl --user "$@" 2>&1) || die "systemctl --user $* failed: $out"
}

# Where systemctl looks for this user's units. A relative XDG_CONFIG_HOME is ignored, as the
# XDG spec says.
user_unit_dir() {
    if [[ ${XDG_CONFIG_HOME:-} == /* ]]; then
        echo "$XDG_CONFIG_HOME/systemd/user"
    else
        echo "${HOME:?}/.config/systemd/user"
    fi
}

# VALUE as one double-quoted word of a unit's command line, where systemd reads \ and " as
# escapes, and % and $ as specifiers and variables.
unit_quote() {
    local s=${1//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//%/%%}
    s=${s//\$/\$\$}
    printf '"%s"\n' "$s"
}

# The value that unit_quote quoted, given without its quotes. A newline stands in for \ on
# the way, which works as setup refuses a DIR with one.
unit_unquote() {
    local s=${1//\\\\/$'\n'}
    s=${s//\\\"/\"}
    s=${s//$'\n'/\\}
    s=${s//%%/%}
    printf '%s\n' "${s//\$\$/\$}"
}

# This instance's daily backup units, as their path without .service or .timer.
backup_unit() {
    echo "$(user_unit_dir)/$name-backup"
}

# The DIR this instance's daily backup writes to. Its service unit is the only record of it:
# the timer is on while that file exists. Fails when there is none.
scheduled_backup_dir() {
    local line
    line=$(grep -m 1 '^ExecStart=' "$(backup_unit).service" 2>/dev/null) || return 1
    # The first `" backup "` ends the quoted claude-sync: every " inside a quoted value has a
    # \ before it.
    line=${line#*\" backup \"}
    unit_unquote "${line%\"}"
}

# Applies setup's BACKUP to this instance's daily backup: a DIR installs it there, off
# removes it, and empty keeps it, rewritten for this claude-sync. Called before setup records
# the version, so that after a failure, which puts back the units it replaced, upgrade runs
# setup again.
schedule_backup() {
    local dir=$1 asked="" path unit bin header service timer saved="" ext
    [[ -z $1 ]] || asked=1
    case $dir in
        off)
            unschedule_backup
            return
            ;;
        '')
            dir=$(scheduled_backup_dir) || return 0
            # Only a warning, as upgrade runs this for every instance. DIR was checked when
            # given; a target set up again around it since can hold it.
            (check_outside_synced_folder "$dir") ||
                printf 'claude-sync: the daily backup into %s fails each day until what is above is fixed, or %s --backup-dir gives it another DIR\n' \
                    "$dir" "$(setup_command "$name")" >&2
            ;;
        *)
            # Checked now, or each daily run would fail where nobody looks.
            check_outside_synced_folder "$dir"
            mkdir -p -- "$dir"
            ;;
    esac
    path=$(backup_unit)
    unit=${path##*/}
    bin=$(readlink -f -- "${BASH_SOURCE[0]}")
    header="# Written by claude-sync setup, which replaces it; $(setup_command "$name") --no-backup removes it."
    service="$header
[Unit]
Description=claude-sync backup of instance $name

[Service]
Type=oneshot
Environment=CLAUDE_SYNC_NAME=$name
ExecStart=$(unit_quote "$bin") backup $(unit_quote "$dir")"
    timer="$header
[Unit]
Description=Daily claude-sync backup of instance $name

[Timer]
OnCalendar=daily
Persistent=true

[Install]
WantedBy=timers.target"
    if [[ $(cat -- "$path.service" 2>/dev/null) != "$service" ||
        $(cat -- "$path.timer" 2>/dev/null) != "$timer" ]]; then
        # Checked before writing: with the files written and not reloaded, the next setup
        # would find nothing changed and not reload them either.
        user_systemd ||
            die "cannot reach systemd's user manager to update $unit.timer; run $(setup_command "$name") again in a login session as $(id -un)"
        mkdir -p -- "${path%/*}"
        # The units this replaces, put back when writing them or systemd fails below: units it
        # never loaded or enabled would pass for installed, and the next setup would find
        # nothing to change.
        saved=$(mktemp -d -t claude-sync.XXXXXX)
        for ext in service timer; do
            [[ ! -e $path.$ext ]] || cp -p -- "$path.$ext" "$saved/" || {
                rm -rf -- "$saved"
                exit 1
            }
        done
    fi
    if ! (
        # set -e is off in an if's condition, so each failure exits by hand.
        [[ -z $saved ]] || {
            printf '%s\n' "$service" >"$path.service" &&
                printf '%s\n' "$timer" >"$path.timer" &&
                user_systemctl daemon-reload
        } || exit 1
        # Only when asked: a timer the user disabled stays so through setup and upgrade.
        [[ -z $asked ]] || user_systemctl enable --now "$unit.timer"
    ); then
        if [[ -n $saved ]]; then
            for ext in service timer; do
                if [[ -e $saved/$unit.$ext ]]; then
                    mv -- "$saved/$unit.$ext" "$path.$ext"
                else
                    rm -f -- "$path.$ext"
                fi
            done
            rm -rf -- "$saved"
            # Best effort, after the failure reported above: if the reload went through and
            # enable failed, systemd has loaded the units this run wrote, not those put back.
            systemctl --user daemon-reload >/dev/null 2>&1 || true
        fi
        exit 1
    fi
    [[ -z $saved ]] || rm -rf -- "$saved"
    # Said only of an enabled timer: one the user disabled does not back up.
    [[ -n $asked ]] || systemctl --user is-enabled --quiet "$unit.timer" 2>/dev/null || return 0
    printf 'Backs up to %s daily; systemctl --user start %s backs up now, and journalctl --user -u %s shows how each backup went.\n' \
        "$dir" "$unit" "$unit"
}

# Whether this instance has a daily backup, even one left half removed.
has_scheduled_backup() {
    local path
    path=$(backup_unit)
    [[ -e $path.service || -e $path.timer ]]
}

# Dies when this instance has a daily backup and systemd's user manager, which removes it,
# cannot be reached. Called before anything else changes, so that the command does not stop
# halfway.
check_unschedule() {
    has_scheduled_backup || return 0
    user_systemd ||
        die "cannot reach systemd's user manager to remove $name-backup.timer; run this again in a login session as $(id -un)"
}

# Removes this instance's daily backup, if it has one. Its archives stay.
unschedule_backup() {
    local path unit dir
    has_scheduled_backup || return 0
    check_unschedule
    path=$(backup_unit)
    unit=${path##*/}
    dir=$(scheduled_backup_dir) || dir=""
    [[ ! -e $path.timer ]] || user_systemctl disable --now "$unit.timer"
    rm -f -- "$path.service" "$path.timer"
    user_systemctl daemon-reload
    echo "Removed the daily backup${dir:+ to $dir}; its archives stay."
}

case ${1:-help} in
    setup)
        shift
        setup "$@"
        ;;
    pair)
        shift
        pair "$@"
        ;;
    unpair)
        shift
        unpair "$@"
        ;;
    uninstall)
        shift
        uninstall "$@"
        ;;
    upgrade)
        shift
        upgrade "$@"
        ;;
    backup)
        shift
        backup "$@"
        ;;
    restore)
        shift
        restore "$@"
        ;;
    list)
        shift
        list "$@"
        ;;
    use)
        shift
        use "$@"
        ;;
    version | --version) echo "claude-sync $claude_sync_version" ;;
    help | -h | --help) usage ;;
    *)
        usage >&2
        exit 2
        ;;
esac
