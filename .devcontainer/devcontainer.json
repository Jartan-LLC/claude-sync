{
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "lts",
      "pnpmVersion": "12"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/jartan-llc/enchantments/claude-code:1": {},
    "ghcr.io/jartan-llc/enchantments/grimoire:1": {},
    "ghcr.io/jartan-llc/enchantments/liza:1": {},
    "ghcr.io/jartan-llc/enchantments/liza-toolchain:1": {},
    "ghcr.io/jartan-llc/enchantments/gh-config:1": {}
  },
  "containerEnv": {
    "HOST_PROJECT_PATH": "${localWorkspaceFolder}",
    "CONTAINER_WORKSPACE_FOLDER": "${containerWorkspaceFolder}",
    "UV_SYSTEM_PYTHON": "1",
    "DOCKER_HOST": "unix:///var/run/docker-host.sock"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode",
        "DavidAnson.vscode-markdownlint",
        "eamodio.gitlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  "waitFor": "postCreateCommand",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh"
}
